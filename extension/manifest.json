{
  "manifest_version": 3,
  "name": "career-ops autofill",
  "version": "0.1.0",
  "description": "Fills job applications with your career-ops answers on any board. Fills and highlights \u2014 never submits.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "career-ops autofill",
    "default_icon": {
      "16": "icons/career-ops-16.png",
      "48": "icons/career-ops-48.png",
      "128": "icons/career-ops-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://boards.greenhouse.io/*",
        "*://job-boards.greenhouse.io/*",
        "*://*.greenhouse.io/*",
        "*://jobs.ashbyhq.com/*",
        "*://jobs.lever.co/*",
        "*://*.lever.co/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/career-ops-16.png",
    "48": "icons/career-ops-48.png",
    "128": "icons/career-ops-128.png"
  }
}
