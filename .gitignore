# Personal data (user fills these)
cv.md
data/applications.md
data/pipeline.md
data/scan-history.tsv
reports/*.md
!reports/.gitkeep
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
batch/tracker-additions/**/*.tsv
!batch/tracker-additions/.gitkeep
jds/*
!jds/.gitkeep

# User config and customization (never auto-updated)
config/profile.yml
portals.yml
modes/_profile.md
.update-dismissed
.update-lock

# Secrets (never commit — use .env.example as template)
.env

# Generated
.resolved-prompt-*
node_modules/
bun.lock

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
career-dashboard
package-lock.json

# --- Additions for vpontual fork ---
# Upstream .gitignore already covers cv.md, config/profile.yml, portals.yml,
# reports/, output/, data/, .env. These additions are for local extras.

# Docker build artifacts
docker-compose.override.yml
.env.local

# Editor scratch
.vscode/
.idea/

# Extra personal docs that must stay local
career-ops-cv.pdf
cv.private.md
article-digest.md
modes/_profile.md
application-defaults.md
logs/
cv-variants/

# Gmail poller / rank-leads outputs (generated)
data/.gmail-cursor
data/inbox-leads.md
data/lead-scores.json
data/pipeline.md.bak-*
logs/gmail-fetch.log
logs/rank-leads.log
.venv-jobspy/
__pycache__/
*.pyc
config/cv-facts.json
data/blacklist.md

# tool-written backups
*.bak-*
*.bak2-*
.loc-backup-*/

# prepared application answers - contain personal contact details
batch/claude-answers/
batch/claude-covers/
batch/gemini-originals/
*.bak*

# Resolved Indeed apply URLs, one entry per posting ever seen. Machine-derived
# and regenerable, and the entries carry per-request redirect tokens
# (indeed-apply-token, rx_viewer) that have no business in the tree.
data/apply-url-cache.json

# A 7-byte dedup cursor of civil-service notice ids already seen. Pure runtime
# state, regenerated by watch-civil-service.mjs.
data/.civil-service-seen
